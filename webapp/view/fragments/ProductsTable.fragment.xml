<c:FragmentDefinition
    xmlns="sap.m"
	xmlns:c="sap.ui.core"
>

    <VBox class="sapUiSmallMargin">
        <Text text="{i18n>filters}"/>
        <Toolbar >
            <Input id="inputId" width="50%" liveChange="onChange" value="{LocalDataModel>/valueInput}"/>

            <ComboBox 
                id="comboboxID"
                selectionChange="onSelectionChange"
                selectedKey="{LocalDataModel>/selectedKey}"
                items="{
					path: '/Categories',
					sorter: { path: 'CategoryName' }
				}">
				<c:Item key="{CategoryID}" text="{CategoryName}" />
            </ComboBox>
            
            <MultiInput
                width="50%"
                showClearIcon="true"
                id="multiInput"
                selectedKey="{LocalDataModel>/selectedKeyMultiInput}"
                tokenUpdate="onMultiInputChange"
                suggestionItems="{
                    path: '/Categories',
					sorter: { path: 'CategoryName' }
                }"
                showValueHelp="false">
                <c:Item key="{CategoryID}" text="{CategoryName}" />
            </MultiInput>

            <MultiComboBox
                width="350px"
                selectedKeys="{LocalDataModel>/selectedKeyMulti}"
                items="{
                    path: '/Suppliers',
                    sorter: { path: 'CompanyName' }
                }">
                <c:Item key="{SupplierID}" text="{CompanyName}"/>
            </MultiComboBox>

            <Button text="{i18n>textBuscar}" press="onFilter"/>
        </Toolbar>
    </VBox>
    <Table inset="false" id="idProductsTable" items="{ path : '/Products'}">
        <columns>
            <Column >
                <Text text="{i18n>productName}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>unitPrice}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>unitsInStock}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>quantityPerUnit}"></Text>
            </Column>
        </columns>
        <items>
            <ColumnListItem vAlign="Middle" type="Active" press="onItemPress">
                <cells>
                    <ObjectIdentifier 
                        title="{ProductID}"
                        text="{ProductName}"/>
                    <ObjectNumber
                        number="{
                            parts:[{path:'UnitPrice'}],
                            type:'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true}
                        }"
                        unit="USD"/>
                    <Text text="{UnitsInStock}"/>
                    <Text text="{QuantityPerUnit}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</c:FragmentDefinition>
