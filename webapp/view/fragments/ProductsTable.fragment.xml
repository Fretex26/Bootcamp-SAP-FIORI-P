<c:FragmentDefinition
    xmlns="sap.m"
	xmlns:c="sap.ui.core"
>

    <VBox class="sapUiSmallMargin">
        <Text text="{i18n>filters}"/>
        <Toolbar height="100px">

            <FlexBox direction="Column" alignItems="Start" width="20%">
                <Label
                text="{i18n>inputText}"
                labelFor="input-b"
                width="100%"
                design="Bold" />
                <Input id="inputId" liveChange="onChange" width="100%" value="{LocalDataModel>/valueInput}"/>
			</FlexBox>

            <FlexBox direction="Column" alignItems="Start" width="20%">
                <Label
                text="{i18n>selectCategories}"
                labelFor="input-b"
                design="Bold" />
                <ComboBox 
                    id="comboboxID"
                    selectionChange="onSelectionChange"
                    selectedKey="{LocalDataModel>/selectedKey}"
                    width="100%"
                    items="{
                        path: '/Categories',
                        sorter: { path: 'CategoryName' }
                    }">
                    <c:Item key="{CategoryID}" text="{CategoryName}" />
                </ComboBox>
			</FlexBox>

            <FlexBox direction="Column" alignItems="Start" width="20%">
                <Label
                text="{i18n>categoriesMultiInput}"
                labelFor="input-b"
                design="Bold" />
                <MultiInput
                    showClearIcon="true"
                    id="multiInput"
                    tokenUpdate="onMultiInputChange"
                    width="100%"
                    suggestionItems="{
                        path: '/Categories',
                        sorter: { path: 'CategoryName' }
                    }"
                    showValueHelp="false">
                    <c:Item key="{CategoryID}" text="{CategoryName}" />
                </MultiInput>
			</FlexBox>

            <FlexBox direction="Column" alignItems="Start" width="20%">
                <Label
                text="{i18n>providers}"
                labelFor="input-b"
                design="Bold" />
                <MultiComboBox
                    selectedKeys="{LocalDataModel>/selectedKeyMulti}"
                    width="100%"
                    items="{
                        path: '/Suppliers',
                        sorter: { path: 'CompanyName' }
                    }">
                    <c:Item key="{SupplierID}" text="{CompanyName}"/>
                </MultiComboBox>
			</FlexBox>

            <Button text="{i18n>textBuscar}" press="onFilter"/>
        </Toolbar>
    </VBox>
    <Table inset="false" id="idProductsTable" items="{ path : '/Products'}">
        <columns>
            <Column >
                <Text text="{i18n>productName}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>unitPrice}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>unitsInStock}"></Text>
            </Column>
            <Column >
                <Text text="{i18n>quantityPerUnit}"></Text>
            </Column>
        </columns>
        <items>
            <ColumnListItem vAlign="Middle" type="Active" press="onItemPress">
                <cells>
                    <ObjectIdentifier 
                        title="{ProductID}"
                        text="{ProductName}"/>
                    <ObjectNumber
                        number="{
                            parts:[{path:'UnitPrice'}],
                            type:'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true}
                        }"
                        unit="USD"/>
                    <Text text="{UnitsInStock}"/>
                    <Text text="{QuantityPerUnit}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</c:FragmentDefinition>
